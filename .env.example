# Copy to .env and adjust. Never commit the real .env.
#
# Every value below is optional: the defaults in src/config/settings.py make
# the system runnable with no .env at all, against the bundled knowledge-graph
# JSON. Uncomment only what you need to change.
#
# Invalid values are rejected at startup with a message naming the variable,
# rather than failing later inside a retriever.

# ---------------------------------------------------------------------------
# Graph source
# ---------------------------------------------------------------------------
# json  = load data/knowledge_graph_ai_sample.json (default; no database needed)
# neo4j = project a live Neo4j database into the same in-memory structure
CORPUS_SOURCE=json
# The full PoC export (5,794 nodes). Paths are relative to the project root, so
# this works from any working directory. This is also the built-in default.
CORPUS_JSON_PATH=axiom_pricing_module_Knowledge-graph_PoC.json

# Neo4j connection, used only when CORPUS_SOURCE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_S=10

# ---------------------------------------------------------------------------
# Corpus derivation
# ---------------------------------------------------------------------------
# How a graph node becomes a citable record. These describe the *strategy*;
# no label or property name is hard-coded anywhere in the codebase.
# CORPUS_ID_KEY_SUFFIX=_id
# CORPUS_NAME_KEY_SUFFIXES=_name,name
# CORPUS_EXCLUDED_PROPERTY_KEYS=_eid,embedding
# CORPUS_MAX_TEXT_CHARS=1024
# CORPUS_FLOAT_PRECISION=4

# Label allow/deny lists (comma-separated; empty = index everything).
# CORPUS_INCLUDE_LABELS=
# CORPUS_EXCLUDE_LABELS=

# ---------------------------------------------------------------------------
# Retrieval fan-out
# ---------------------------------------------------------------------------
DEFAULT_TOP_K=10
# Each modality retrieves top_k * CANDIDATE_MULTIPLIER before fusion, giving
# RRF room to promote records several streams agree on.
# CANDIDATE_MULTIPLIER=4
# MAX_CANDIDATE_TOP_K=200

# ---------------------------------------------------------------------------
# Lexical (BM25)
# ---------------------------------------------------------------------------
# BM25_K1=1.5
# BM25_B=0.75
# BM25_EPSILON=0.25
# Unicode-aware pattern: keeps SKU0001 whole and segments Arabic.
# BM25_TOKEN_PATTERN=[^\W_]+
# BM25_MIN_TOKEN_LENGTH=1

# ---------------------------------------------------------------------------
# Dense (semantic)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_NORMALIZE=true
# Leave blank to let sentence-transformers pick (cuda when available).
# EMBEDDING_DEVICE=

# ---------------------------------------------------------------------------
# Graph traversal
# ---------------------------------------------------------------------------
# GRAPH_MAX_HOPS=2
# Relevance decay per hop: 1 hop scores 1.0, 2 hops 0.5, 3 hops 0.25.
# This is what gives the graph stream a meaningful rank order.
# GRAPH_HOP_DECAY=0.5
# Measured configuration: 400 (the built-in default is 200).
GRAPH_MAX_NEIGHBORS=400
# GRAPH_DIRECTED=false
# Empty = traverse every relationship type present in the graph.
# GRAPH_RELATIONSHIP_TYPES=
# GRAPH_ANCHOR_PATTERN=\b[A-Za-z][A-Za-z_]*\d{2,}\b
# GRAPH_MAX_ANCHORS=4

# ---------------------------------------------------------------------------
# Fusion (Reciprocal Rank Fusion)
# ---------------------------------------------------------------------------
# Smoothing constant. Higher flattens the head, so cross-modal agreement
# outweighs depth within any single stream.
RRF_K=60
# Per-stream weights as a JSON object, keyed by stream name. Any stream the
# pipeline registers can be weighted here without a code change.
# Measured configuration: the dense stream is down-weighted to 0.3 because it is
# weak on this corpus of near-identical key-value records. Without this line
# every stream has weight 1.0 and the reported retrieval numbers do not
# reproduce.
FUSION_STREAM_WEIGHTS={"bm25": 1.0, "graph": 1.0, "dense": 0.3}
# FUSION_DEFAULT_WEIGHT=1.0
# FUSION_MAX_CANDIDATES=100

# ---------------------------------------------------------------------------
# Cross-encoder reranking
# ---------------------------------------------------------------------------
# Measured configuration: disabled. The cross-encoder raises top-1 but lowers
# recall@10 on this corpus (see the final report). The code default is true.
RERANK_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Only this many fused candidates are scored by the cross-encoder.
RERANK_TOP_N=20
# RERANK_BATCH_SIZE=32
# sigmoid maps the model's unbounded logit into (0,1) so that RERANK_MIN_SCORE
# is a stable, auditable relevance floor. Use identity to see raw logits.
RERANK_SCORE_TRANSFORM=sigmoid
# Relevance floor on the calibrated score. 0.0 keeps everything.
RERANK_MIN_SCORE=0.0
# Results always retained even if all fall below the floor. Set to 0 to allow
# an empty result, the retrieval-side precondition for an honest abstention.
RERANK_MIN_RESULTS=1
# true => a model failure degrades to fused order instead of failing the request.
RERANK_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# LLM (text-to-Cypher and grounded generation)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_API_KEY=
# LLM_TEMPERATURE=0.0
# LLM_REQUEST_TIMEOUT_S=60
# LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Text-to-Cypher (D3)
# ---------------------------------------------------------------------------
# TEXT_TO_CYPHER_ENABLED=true

# Self-heal attempts after the first. Each retry is shown the previous query
# and the exact error it produced -- the database's own wording, not a
# paraphrase, because that is the signal the repair depends on.
# TEXT_TO_CYPHER_MAX_RETRIES=3

# Schema pruning: only labels sharing at least this many tokens with the
# question are shown to the model, capped at max_schema_labels so the prompt
# stays bounded. Falls back to the full schema when nothing matches, since an
# empty schema makes a correct query impossible.
# TEXT_TO_CYPHER_MIN_SCHEMA_OVERLAP=1
# TEXT_TO_CYPHER_MAX_SCHEMA_LABELS=12

# Few-shot examples drawn from data/cypher_examples.json, ranked by overlap
# with the question. Set to 0 to prompt with no examples at all.
# TEXT_TO_CYPHER_MAX_FEW_SHOT_EXAMPLES=3

# A safety net, not a correctness feature: an aggregate returns one row, but
# an unfiltered plan could return every record of a label.
# TEXT_TO_CYPHER_MAX_RESULT_ROWS=200

# Added to the base temperature on each retry. At temperature 0 a model
# re-reads a corrected prompt and greedily regenerates the same rejected
# plan -- observed with qwen2.5 returning byte-identical output on all four
# attempts -- so a self-heal loop that does not vary sampling cannot escape
# its first answer. Set to 0.0 to keep every attempt fully deterministic.
# TEXT_TO_CYPHER_RETRY_TEMPERATURE_STEP=0.3

# ---------------------------------------------------------------------------
# Grounded narrative generation (D4)
# ---------------------------------------------------------------------------
# NARRATIVE_ENABLED=true

# Corrective attempts after the first. Each one is shown the exact
# verification violations and the text that produced them. Past this the
# generator abstains rather than serving an unverified explanation. At 1,
# the combined recommendation+waterfall prompt abstained on a model that
# invented a subtotal twice in a row; 2 leaves room to recover without
# turning the check into a formality.
# NARRATIVE_MAX_RETRIES=2

# Upper bound on narrative length. Longer narratives invite the model to
# pad with derived figures, which the verifier then rejects.
# NARRATIVE_MAX_WORDS=130

# Currency minor units: a narrative may write 89,489.98 for a computed
# 89489.98 without that counting as a newly invented number.
# NARRATIVE_ABSOLUTE_TOLERANCE=0.01

# Proportional slack for a figure rounded for readability. At 0.005, a
# stated 13.2% clears a computed 13.2% but a stated 15% does not. Every
# unit of slack here is room to state a number nobody computed.
# NARRATIVE_RELATIVE_TOLERANCE=0.005

# Fraction of numeric claims that must carry a citation. The acceptance
# criterion reads "every narrative claim cites a specific record", so 1.0 is
# the faithful default: a sentence stating a figure with no record attached is
# exactly the unsupported statement the criterion forbids. Measured on a
# 12-payload evaluation set, enforcing 1.0 took the service rate from 58% to
# 100% once the prompt carried a worked example of the required density --
# the threshold was kept and the prompt was fixed, not the other way round.
# NARRATIVE_MIN_CITATION_COVERAGE=1.0

# NARRATIVE_RETRY_TEMPERATURE_STEP=0.2

# ---------------------------------------------------------------------------
# Reliability layer (D5)
# ---------------------------------------------------------------------------
# RELIABILITY_ENABLED=true

# Narratives sampled per explanation. The onboarding plan specifies k=3.
# Sampling k times multiplies inference cost k-fold; 1 degrades this to the
# D4 behaviour with the attribution check still applied.
# RELIABILITY_SAMPLES=3

# How many samples must pass verification AND attribution before anything is
# served. Cannot exceed RELIABILITY_SAMPLES -- that would abstain forever, so
# it is refused at construction rather than discovered at runtime.
# RELIABILITY_MIN_VERIFIED=2

# Consensus-core fraction below which samples are judged to disagree.
# Measured across the 12-payload eval set, healthy runs score 0.60-1.00 with
# a mean of 0.78, so 0.6 sits just under the observed floor: samples that
# merely differ in breadth pass, samples describing different figures do not.
# RELIABILITY_MIN_AGREEMENT=0.6

# Sampling temperature. Must be above zero: at 0 the model returns k
# identical texts, which agree perfectly and measure nothing while costing k
# times as much.
# RELIABILITY_SAMPLE_TEMPERATURE=0.7

# Whether a misattributed sample is disqualified from voting -- the check
# that catches a figure landing on the wrong noun ("the invoice price is
# <list price value>"), which passes verification cleanly. Attribution is
# always measured; this only controls enforcement, and turning it off is how
# evaluate_narratives.py --no-reliability produces a genuine D4 baseline.
# Leaving the gate active on both sides of that comparison measures nothing.
# RELIABILITY_ENFORCE_ATTRIBUTION=true

# Corrective retrieval: when evidence is thin, re-retrieve on-subject records
# and admit them as citable. It adds records, never figures.
# RELIABILITY_CORRECTIVE_ENABLED=true

# Citable records per figure below which evidence counts as thin. This is the
# trigger the remedy can actually move. Per-figure provenance (citation
# density) is upstream in Track A's contract and is reported, not triggered
# on -- a trigger its own remedy cannot move fires forever and fixes nothing.
# RELIABILITY_MIN_SUPPORT_RATIO=0.75

# RELIABILITY_CORRECTIVE_TOP_K=6
# RELIABILITY_CORRECTIVE_MAX_ADDED=4

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Set to 1 to run the live Neo4j integration tests (skipped by default).
# RUN_LIVE_GRAPH_TESTS=0
